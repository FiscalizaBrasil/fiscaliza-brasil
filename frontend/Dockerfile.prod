# Stage 1 – build
# VITE_API_URL must be set at build time so Vite can embed it into
# the compiled JS bundles (import.meta.env is resolved at build time,
# NOT at runtime for static builds).
FROM node:22-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=https://fiscalizabr.duckdns.org
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2 – serve with Caddy
# The VPS native Caddy reverse-proxies to port 80 of this container
# (mapped as 5173:80 in docker-compose), so the existing Caddyfile
# on the VPS needs no changes.
FROM caddy:2-alpine

COPY --from=builder /app/dist /srv
COPY Caddyfile.prod /etc/caddy/Caddyfile

EXPOSE 80

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
